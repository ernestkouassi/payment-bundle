{
  "name": "e2k/payment-bundle",
  "description": "Symfony payment gateway abstraction bundle (CentralBill, extensible).",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "payment",
    "gateway",
    "centralbill",
    "symfony",
    "bundle"
  ],
  "authors": [
    {
      "name": "Ernest KOUASSI",
      "email": "ernestkouassi02@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "E2K\\PaymentBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "E2K\\PaymentBundle\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "test:cov": "phpunit --coverage-html=var/coverage",
    "stan": "phpstan analyse --ansi",
    "cs": "php-cs-fixer fix --dry-run --diff --ansi",
    "cs:fix": "php-cs-fixer fix --ansi",
    "qa": [
      "@test",
      "@stan",
      "@cs"
    ]
  },
  "extra": {
    "symfony": {
      "require": "^6.4 || ^7.4",
      "allow-contrib": true
    }
  },
  "require": {
    "php": ">=8.2",
    "symfony/http-kernel": "^6.4 || ^7.4",
    "symfony/http-foundation": "^8.1.4",
    "symfony/dependency-injection": "^8.1.4",
    "symfony/config": "^8.1.4",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.0",
    "symfony/framework-bundle": "^6.4 || ^7.4",
    "symfony/phpunit-bridge": "^8.1",
    "symfony/translation": "^8.1"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
